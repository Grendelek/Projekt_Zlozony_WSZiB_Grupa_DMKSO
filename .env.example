# Example values only; keep your actual .env out of Git.
POSTGRES_USER=dormtech
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=dormtech
POSTGRES_PORT=5432
# Used by Prisma commands run on the host machine from dormtech/.
DATABASE_URL=postgresql://dormtech:change_this_local_password@localhost:5432/dormtech
# Replace with a cryptographically random value, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_random_32_byte_secret
